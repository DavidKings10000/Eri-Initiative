# Copy to .env.local for local development: cp .env.example .env.local
# Every value below is optional locally. Anything left blank falls back to a safe mode:
#   - no database      -> news/impact use the built-in fallback content
#   - no Stripe key    -> donations redirect to a demo confirmation (no real payment)
#   - no Resend keys   -> volunteer and contact forms return "not configured yet"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=https://portal.eristreetinitiative.org

# Postgres (Vercel Postgres / Neon). Needed for `npm run seed`.
DATABASE_URL=

# Stripe checkout for donations (use sk_test_... keys locally)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend email delivery for the volunteer and contact forms
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# M-Pesa (not wired up yet)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
